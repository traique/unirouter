# Bắt buộc: mật khẩu trang /admin (để trống = tắt trang quản trị)
ADMIN_PASSWORD=doi-mat-khau-nay
ADMIN_USERNAME=admin

# Rất nên đặt: dùng để mã hóa token/API key trong SQLite và ký cookie.
# Tạo bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
# ĐỪNG đổi sau khi đã thêm tài khoản (sẽ không giải mã được dữ liệu cũ).
SECRET_KEY=

# Tùy chọn: key "master" gọi được mọi model (key cho từng bot nên tạo trong /admin)
MASTER_API_KEY=

# Cổng: Botkeep/Pterodactyl thường tự cấp SERVER_PORT; nơi khác dùng PORT. Mặc định 20128.
# PORT=20128
# Thư mục lưu SQLite (mặc định ./data)
# DATA_DIR=data
# Cookie admin chỉ gửi qua HTTPS: auto | true | false
# COOKIE_SECURE=auto
# Timeout chờ upstream (giây)
# REQUEST_TIMEOUT=300
# LOG_LEVEL=info
